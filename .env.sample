# 이 VM에서 실행할 Compose 프로필을 쉼표로 구분합니다. 가능한 값은 db, backend, frontend입니다.
COMPOSE_PROFILES=db,backend,frontend

# PostgreSQL의 호스트 5432 포트를 바인딩할 주소입니다. 원격 DB VM이 아니면 루프백을 유지합니다.
DB_BIND_ADDRESS=127.0.0.1

# FastAPI의 호스트 8000 포트를 바인딩할 주소입니다. 원격 Frontend VM이 아니면 루프백을 유지합니다.
BACKEND_BIND_ADDRESS=127.0.0.1

# Nginx의 호스트 80 포트를 바인딩할 주소입니다. 외부 LB가 접근할 수 있는 사설 주소 또는 0.0.0.0을 사용합니다.
FRONTEND_BIND_ADDRESS=0.0.0.0

# Frontend Nginx가 접근할 Backend 내부 URL입니다. 후행 슬래시를 붙이지 않으며 변경 시 컨테이너만 재생성합니다.
BACKEND_UPSTREAM=http://backend:8000

# 브라우저가 직접 호출할 API URL입니다. 빈 값이면 동일 Origin의 Nginx 프록시를 사용하며 변경 시 Frontend 재빌드가 필요합니다.
VITE_API_URL=

# 사용자가 접속하는 Frontend 전체 Origin입니다. 경로나 후행 슬래시 없이 scheme://host[:port] 형식으로 입력합니다.
FRONTEND_HOST=http://localhost:5173

# 실행 환경입니다. local, staging, production 중 하나를 사용합니다.
ENVIRONMENT=local

# API 문서, 이메일 등에 표시할 프로젝트 이름입니다.
PROJECT_NAME="EvalHub API"

# Compose 프로젝트를 구분할 스택 이름입니다. 환경별로 서로 다른 값을 사용하는 것이 좋습니다.
STACK_NAME=evaluation-hub

# Backend를 브라우저가 직접 호출할 때 허용할 추가 Origin 목록입니다. 쉼표로 구분하며 경로, 후행 슬래시, *를 사용하지 않습니다.
BACKEND_CORS_ORIGINS=http://localhost:5173

# JWT 서명에 사용할 비밀 키입니다. 배포 전에 `python -c "import secrets; print(secrets.token_urlsafe(32))"`로 생성한 값으로 교체합니다.
SECRET_KEY=changethis

# 액세스 토큰의 유효 시간(분)입니다. 기본값 11520은 8일입니다.
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# 최초 생성할 관리자 계정의 이메일 주소입니다.
FIRST_SUPERUSER=admin@example.com

# 최초 관리자 계정의 비밀번호입니다. staging/production에서는 반드시 안전한 값으로 교체합니다.
FIRST_SUPERUSER_PASSWORD=changethis

# 이메일을 전송할 SMTP 서버 주소입니다. 이메일 기능을 사용하지 않으면 비워 둡니다.
SMTP_HOST=

# SMTP 서버 포트입니다. STARTTLS는 보통 587, 암시적 TLS는 보통 465를 사용합니다.
SMTP_PORT=587

# SMTP 인증 사용자 이름입니다. 인증이 필요 없으면 비워 둡니다.
SMTP_USER=

# SMTP 인증 비밀번호입니다. 인증이 필요 없으면 비워 둡니다.
SMTP_PASSWORD=

# SMTP 연결에서 STARTTLS를 사용할지 지정합니다. true 또는 false를 사용합니다.
SMTP_TLS=true

# SMTP 연결 시작부터 TLS를 사용할지 지정합니다. SMTP_TLS와 동시에 활성화하지 않습니다.
SMTP_SSL=false

# 발신자 이메일 주소입니다. SMTP를 사용하지 않으면 비워 둘 수 있습니다.
EMAILS_FROM_EMAIL=info@example.com

# 이메일에 표시할 발신자 이름입니다. 비워 두면 PROJECT_NAME을 사용합니다.
EMAILS_FROM_NAME=

# 비밀번호 재설정 토큰의 유효 시간(시간)입니다.
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

# Backend가 접속할 PostgreSQL 서비스명, 사설 DNS 또는 IP입니다. 로컬 호스트 개발은 localhost, 동일 Compose는 db를 사용합니다.
POSTGRES_SERVER=localhost

# PostgreSQL 서버 포트입니다.
POSTGRES_PORT=5432

# 사용할 PostgreSQL 데이터베이스 이름입니다.
POSTGRES_DB=app

# PostgreSQL 접속 사용자 이름입니다.
POSTGRES_USER=postgres

# PostgreSQL 접속 비밀번호입니다. staging/production에서는 반드시 안전한 값으로 교체합니다.
POSTGRES_PASSWORD=changethis

# 오류 추적에 사용할 Sentry DSN입니다. Sentry를 사용하지 않으면 비워 둡니다.
SENTRY_DSN=

# Backend 이미지 이름입니다. 로컬 빌드는 backend, 배포는 레지스트리 경로를 사용할 수 있습니다.
DOCKER_IMAGE_BACKEND=backend

# Frontend 이미지 이름입니다. 로컬 빌드는 frontend, 배포는 레지스트리 경로를 사용할 수 있습니다.
DOCKER_IMAGE_FRONTEND=frontend

# Backend와 Frontend 이미지에 공통으로 적용할 태그입니다.
TAG=latest
